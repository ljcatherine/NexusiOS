# Copy this to the ignored, owner-only local/nexus-gateway.env before local use.
# Replace every example value. The service refuses to start with a missing policy.
NEXUS_GATEWAY_LISTEN=127.0.0.1:8787
# Cloudflare Access Managed OAuth path: issuer is the team.cloudflareaccess.com URL,
# audience is the Access application's AUD tag, and JWKS is the Access certs endpoint.
# Set principal claim to email so permissions can target the Access-verified owner email.
NEXUS_OIDC_ISSUER=https://team.cloudflareaccess.com
NEXUS_OIDC_AUDIENCE=replace-with-application-aud-tag
NEXUS_OIDC_JWKS_URL=https://team.cloudflareaccess.com/cdn-cgi/access/certs
NEXUS_OIDC_PRINCIPAL_CLAIM=email
NEXUS_SUBJECT_PERMISSIONS_JSON='{"owner@example.invalid":["ai.models","ai.chat","ssh.connect"]}'

# Optional Cloudflare SSH relay. Keep both private keys on the gateway server;
# Nexus does not import or persist an SSH key for profiles routed through Cloudflare.
# Restrict each upstream authorized_keys entry (for example: restrict,pty).
NEXUS_SSH_UPSTREAM_KEY=/var/lib/nexus-gateway/ssh/upstream_ed25519
NEXUS_SSH_RELAY_HOST_KEY=/var/lib/nexus-gateway/ssh/relay_host_ed25519
NEXUS_SSH_KNOWN_HOSTS=/var/lib/nexus-gateway/ssh/known_hosts
NEXUS_SSH_TARGETS_JSON='{"nixos":{"host":"192.0.2.10","port":22,"username":"user"},"debian":{"host":"127.0.0.1","port":22,"username":"server"}}'

# Optional conversation sync stays disabled until an owner-only random key is configured.
# Grant "ai.history" only to the approved subject(s) that need this feature.
NEXUS_CONVERSATIONS_DIR=/var/lib/nexus-gateway/conversations
NEXUS_CONVERSATION_ENCRYPTION_KEY=

# Required durable journal for model switches. The directory is created private
# (0700), and the journal is atomically written with owner-only permissions.
NEXUS_MODEL_STATE_PATH=/var/lib/nexus-gateway/model-state/pending-switch.json

# Keep the PS5 inference server private. Use its current LAN/tailnet IPv4 here,
# outside Git. Cleartext is accepted only for RFC1918/link-local/Tailscale IPv4.
NEXUS_AI_UPSTREAM_URL=http://192.0.2.1:8081/v1
# Optional upstream service token; do not put the user's OIDC token here.
NEXUS_AI_UPSTREAM_TOKEN=
NEXUS_AI_ALLOWED_MODELS=replace-with-model-id-returned-by-v1-models
NEXUS_AI_REQUEST_TIMEOUT=15m
NEXUS_AI_REQUESTS_PER_MINUTE=30
# Separate per-owner GET model/context/status budget; polling cannot starve chat.
NEXUS_AI_METADATA_REQUESTS_PER_MINUTE=120
NEXUS_AI_MAX_CONCURRENT=2

# Optional web search. Leave provider empty to keep search disabled.
# To enable, also grant "ai.search" to an explicitly approved OIDC subject above.
# Brave keeps this key server-side; never put it in the iOS app or URL.
NEXUS_SEARCH_PROVIDER=
NEXUS_BRAVE_API_KEY=
# For self-hosted SearXNG, select searxng and configure a private HTTP or HTTPS URL.
NEXUS_SEARXNG_URL=
NEXUS_SEARCH_TIMEOUT=15s
NEXUS_SEARCH_MAX_RESULTS=5
# Defaults to true when search is configured; set false to return search snippets only.
NEXUS_SEARCH_FETCH_PAGES=

# Restricted commands remain unavailable until host/review/native wiring is complete.
# Execution requires nexus.workspace.execute plus this independent root grant,
# existing orchestration/chat/read scopes and the normal read-root grant.
# Write grants never imply command execution. Empty/missing denies all commands.
NEXUS_WORKSPACE_EXECUTE_GRANTS_JSON='{}'
