--- a/scripts/build-app.sh
+++ b/scripts/build-app.sh
@@ -74,7 +74,16 @@
 cxx -std=c++20 -fexceptions -fcxx-exceptions -frtti -I "$headers/include" -I "$llama/ggml/include" -I "$root/third_party/ps5-homebrew-ui/src" \
     -I "${PS5_OPENGL_SDK:-$root/.deps/ps5-opengl/ps5-opengl-sdk-1.0.0/sdk}/include" -DGL_GLEXT_PROTOTYPES=1 \
     -c "$root/ps5/app/main.cpp" -o "$obj/main.o"
-cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/vendor" -c "$root/ps5/app/nexus_control.cpp" -o "$obj/nexus_control.o"
+nexus_control_pin_flags=()
+if [[ -n "${NEXUS_PS5_CONTROL_PIN_HEADER:-}" ]]; then
+    [[ -f "$NEXUS_PS5_CONTROL_PIN_HEADER" && ! -L "$NEXUS_PS5_CONTROL_PIN_HEADER" &&
+       "$(stat -c %u "$NEXUS_PS5_CONTROL_PIN_HEADER")" == "$(id -u)" &&
+       "$(stat -c %a "$NEXUS_PS5_CONTROL_PIN_HEADER")" == 600 ]] || {
+        echo "build-app: provisioning header must be an owner-private regular file" >&2; exit 2;
+    }
+    nexus_control_pin_flags=(-DNEXUS_CONTROL_REQUIRE_PROVISIONING_PIN=1 -include "$NEXUS_PS5_CONTROL_PIN_HEADER")
+fi
+cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/vendor" "${nexus_control_pin_flags[@]}" -c "$root/ps5/app/nexus_control.cpp" -o "$obj/nexus_control.o"
 cxx -fexceptions -fcxx-exceptions -c "$root/ps5/app/model_plan.cpp" -o "$obj/model_plan.o"
 cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/vendor" -c "$root/ps5/app/settings.cpp" -o "$obj/settings.o"
 cxx -std=c++20 -fexceptions -fcxx-exceptions -c "$root/ps5/app/fetch.cpp" -o "$obj/fetch.o"
