diff --git a/vendor/nlohmann/json.hpp b/vendor/nlohmann/json.hpp
--- a/vendor/nlohmann/json.hpp
+++ b/vendor/nlohmann/json.hpp
@@ -7176,5 +7176,9 @@ class lexer : public lexer_base<BasicJsonType>
     {
         const auto* loc = localeconv();
         JSON_ASSERT(loc != nullptr);
-        return (loc->decimal_point == nullptr) ? '.' : *(loc->decimal_point);
+        // The PS5's localeconv() can return a non-null, empty decimal-point
+        // string. Without this guard, scan_number() inserts a NUL into a
+        // JSON fraction, then strtod stops short and hits JSON_ASSERT.
+        // JSON numbers require '.', which is the C locale's separator.
+        return (loc->decimal_point == nullptr || *(loc->decimal_point) == '\0') ? '.' : *(loc->decimal_point);
     }
