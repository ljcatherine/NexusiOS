diff --git a/ps5/app/main.cpp b/ps5/app/main.cpp
index 3c5e2fa..c526319 100644
--- a/ps5/app/main.cpp
+++ b/ps5/app/main.cpp
@@ -50,0 +51 @@
+#include "nexus_control.hpp"
@@ -931,0 +933,9 @@ int main(int, char **) {
+    // Management stays disabled until a strong token's SHA-256 digest has
+    // been provisioned in a private owned file. A second opt-in marker is
+    // needed to listen on the LAN instead of loopback.
+    NexusControl nexus;
+    const bool nexus_lan = access((kDir + "/nexus-control.lan").c_str(), F_OK) == 0;
+    if (nexus.start(kDir + "/nexus-control.token", nexus_lan)) {
+        std::printf("ps5lm-app: Nexus control listening on %s:8082\n",
+                    nexus_lan ? "private LAN" : "loopback");
+    }
@@ -1022,0 +1033,3 @@ int main(int, char **) {
+        if (n % 30 == 0) {
+            nexus.publish(live, models.rows);
+        }
@@ -1129,0 +1143,7 @@ int main(int, char **) {
+            // On a successful LoadExec the process is replaced and never
+            // returns. A failed restart must not leave the control API stuck
+            // reporting `switching` and rejecting every subsequent request.
+            nexus.mark_restart_failed();
+            restart_at = 0;
+            dash.set_busy("");
+            stats.set_state(ServerState::failed);
@@ -1132,0 +1153,7 @@ int main(int, char **) {
+        if (req.kind == Dashboard::Request::none) {
+            if (auto remote_model = nexus.take_request()) {
+                req = *remote_model == "none"
+                    ? Dashboard::Request{ Dashboard::Request::unload, "" }
+                    : Dashboard::Request{ Dashboard::Request::load, *remote_model };
+            }
+        }
