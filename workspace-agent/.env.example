# Copy into a private, root-readable or service-user-readable environment file.
# NEVER commit an actual token or enable unauthenticated/public direct access.
# One instance per host; keep Debian/NixOS tokens distinct.

# On the Debian laptop set debian. On the NixOS workstation set nixos.
NEXUS_WORKSPACE_HOST=debian

# Listen on loopback only. Put a privately authenticated HTTPS proxy in front.
NEXUS_WORKSPACE_LISTEN=127.0.0.1:8896

# Generate a unique cryptographically random token per host; 32–256 chars.
# Example command: openssl rand -hex 32
NEXUS_WORKSPACE_TOKEN=

# Absolute pre-existing roots, no symlink components. Do not include home or /.
# Replace with suitable owner-controlled project directories on each host.
NEXUS_WORKSPACE_ROOTS_JSON='[{"id":"projects","name":"Projects","path":"/home/REPLACE_USER/Projects"}]'

# Optional Git inspection: add "git_read":true to each permitted root above.
# All three paths are required if any root opts in. Git inspection fails closed
# if bubblewrap >= 0.12 or required Linux namespaces are unavailable.
# Programs must be system-administered or reside in an immutable Nix package.
# NEXUS_WORKSPACE_GIT_EXECUTABLE=/usr/bin/git
# NEXUS_WORKSPACE_BWRAP_EXECUTABLE=/usr/bin/bwrap
# NEXUS_WORKSPACE_PRLIMIT_EXECUTABLE=/usr/bin/prlimit

# DO NOT enable unless behind appropriate network-level access controls and TLS.
# NEXUS_WORKSPACE_ALLOW_NON_LOOPBACK=1
